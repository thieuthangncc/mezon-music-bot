generator client {
  provider = "prisma-client"
  output   = "../src/_generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String @id
  username            String
  avatar              String
  clanId              String
  streamingChannelId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
