generator client {
  provider = "prisma-client"
  output   = "../src/_generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id
  username String
  avatar   String

  clans          Clan[]
  refreshTokens  RefreshToken[]
  roomMembers    RoomMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Clan {
  id      String @id
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  channel StreamingChannel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StreamingChannel {
  id     String  @id
  clanId String  @unique
  clan   Clan    @relation(fields: [clanId], references: [id])
  name   String?
  isPrivate Boolean @default(false)

  playlist Playlist[]
  members  RoomMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Playlist {
  id                String           @id
  streamingChannelId String
  streamingChannel  StreamingChannel @relation(fields: [streamingChannelId], references: [id])

  songs PlaylistSong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlaylistSong {
  id            String @id
  playlistId    String
  playlist      Playlist @relation(fields: [playlistId], references: [id])
  songUrl       String
  songFileName  String?
  order         Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime

  createdAt DateTime @default(now())
}

model RoomMember {
  id                 String           @id
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  streamingChannelId String
  streamingChannel   StreamingChannel @relation(fields: [streamingChannelId], references: [id])
  joinedAt           DateTime         @default(now())

  createdAt DateTime @default(now())

  @@unique([userId, streamingChannelId])
}
