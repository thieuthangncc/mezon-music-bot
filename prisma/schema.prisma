generator client {
  provider     = "prisma-client"
  output       = "../src/_generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id
  username String
  avatar   String

  clans         Clan[]
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Clan {
  id            String   @id
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])
  moderatorIds  String[] @default([])

  playlist Playlist?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Playlist {
  id                String    @id
  clanId            String    @unique
  clan              Clan      @relation(fields: [clanId], references: [id])
  currentOrder      Int?
  playbackStartedAt DateTime?
  voiceChannelId    String?
  voiceChannelName  String?

  songs PlaylistSong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlaylistSong {
  id              String  @id
  playlistId      String
  playlist        Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  songUrl         String
  playableUrl     String?
  title           String?
  thumbnailUrl    String?
  authorName      String?
  durationSeconds Int?
  requestedBy     String?
  order           Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime

  createdAt DateTime @default(now())
}

model CachedSong {
  id              String @id
  title           String
  youtubeUrl      String
  youtubeVideoId  String @unique
  oggUrl          String
  thumbnailUrl    String?
  authorName      String?
  authorUrl       String?
  providerName    String?
  durationSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
}
